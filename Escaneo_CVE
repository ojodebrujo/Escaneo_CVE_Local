#!/usr/bin/env python3
"""
Escaneo CVE por VERSION (un solo archivo, sin framework) -- monitor NVD LOCAL.

Pide los dominios por consola (uno solo, o varios con coma/espacio). Por cada uno:
IP, SSL, tecnologias+version con Wappalyzer (modo rapido, sin navegador), y los CVE
que apliquen buscando POR VERSION contra un indice LOCAL construido desde el espejo
NVD en bloque (fkie-cad/nvd-json-data-feeds): se baja TODA la base una sola vez y
despues solo se actualizan los CVE nuevos/modificados (delta). NO usa la API de NVD,
asi que no hay rate-limit. Enriquece con CISA KEV (fue explotado activamente, con
fecha) y EPSS (probabilidad de explotacion) -> el historial de "que tan fuerte fue".
Imprime el resultado en pantalla (CMD) y ademas genera un Excel.

    python escaneo.py
    python escaneo.py  example.com, www.example.org, example.net

La 1a vez baja ~107 MB (por anios) y construye el indice (tarda unos minutos).
Luego cada corrida solo baja el delta (~10 MB) si hay cambios.

    pip install wappalyzer openpyxl requests     (lzma es parte de Python)
"""
import os, re, sys, json, time, ssl, socket, gzip, lzma, requests, openpyxl
from datetime import datetime
from urllib.parse import urlparse
from concurrent.futures import ThreadPoolExecutor, as_completed
from wappalyzer import analyze

# -- CONFIG --------------------------------------------------------------------
AQUI      = os.path.dirname(os.path.abspath(__file__))
NVD_DIR   = os.path.join(AQUI, "nvd_cache")
INDEX_FILE= os.path.join(NVD_DIR, "nvd_index.json")
STATE_FILE= os.path.join(NVD_DIR, "nvd_state.json")
FEEDS_DIR = os.path.join(AQUI, "feeds_cache")
WORKERS   = 10
SCAN_TYPE = "fast"     # fast = solo HTTP (rapido). balanced/full abren navegador (lento).
TIMEOUT   = 25
CONSULTAR_FEEDS = True  # KEV + EPSS. Ponlo en False si no los quieres.

REL_BASE  = "https://github.com/fkie-cad/nvd-json-data-feeds/releases/latest/download"
REL_API   = "https://api.github.com/repos/fkie-cad/nvd-json-data-feeds/releases/latest"
ANIO_INI  = 1999
KEV_URL   = "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
EPSS_URL  = "https://epss.empiricalsecurity.com/epss_scores-current.csv.gz"
UA        = {"User-Agent": "Scanner/3.0"}

ORDEN = {"CRITICAL": 4, "HIGH": 3, "MEDIUM": 2, "LOW": 1, "NONE": 0}
def sev_max(cves): return max(cves, key=lambda c: ORDEN.get(c["severity"], 0))["severity"] if cves else "LIMPIO"
def norm(s): return re.sub(r"[^a-z0-9]", "", (s or "").lower())
def pv(v):
    n = re.findall(r"\d+", str(v)) if v else []
    return tuple(int(x) for x in n[:4]) if n else None
def vcmp(a, b):
    if a is None or b is None: return 0
    la, lb = list(a)+[0]*(4-len(a)), list(b)+[0]*(4-len(b))
    return (la > lb) - (la < lb)

# -- CPE: nombre de tecnologia (Wappalyzer) -> vendor:producto del CPE de NVD --
# clave normalizada con norm(); desambigua productos homonimos por vendor.
